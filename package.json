{
  "name": "putri-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:themes": "node --test tests/themes.test.mjs",
    "test:chat": "node --test tests/portfolio-chat.test.mjs tests/webllm-prompt.test.mjs tests/webllm-runtime.test.mjs",
    "format": "prettier --write app lib tests next.config.ts package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check app lib tests next.config.ts package.json tsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.87",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  }
}
